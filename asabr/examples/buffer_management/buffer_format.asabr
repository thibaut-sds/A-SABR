# Nodes: node <id> <name> <capacity>
# Only Satellite (node 1) has a tight buffer limit (1000), Earth and Mars have large capacities
node 0 Earth 50000000
node 1 Satellite 1000
node 2 Mars 50000000

# Contacts (EVLManager): contact <from> <to> <start> <end> <rate> <delay>
contact 0 1 0 100 1000 0
contact 1 2 60 70 60 0
contact 1 2 80 90 100 0
